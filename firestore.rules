rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own document
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Helper function to check if user is Admin (Ulas or Emir)
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName == "Ulas" ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName == "Emir");
    }

    // Helper: Check if user is a member of the plugin
    function isMember(pluginId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/plugins/$(pluginId)/members/$(request.auth.uid));
    }

    // Helper: Check if user is an owner of the plugin (via members role)
    function isPluginOwner(pluginId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/plugins/$(pluginId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/plugins/$(pluginId)/members/$(request.auth.uid)).data.role == "owner";
    }

    // Helper: Check if user is the creator of the plugin document (for initial setup)
    function isCreator(pluginId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/plugins/$(pluginId)).data.createdByUid == request.auth.uid;
    }

    // Users collection: User can read/write only their own doc
    // Allow reading other users' display names for adding members?
    // We need to query users by displayName. So we need read access to users.
    // Let's allow read for authenticated users, write for owner.
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid) && request.resource.data.displayName != "Ulas" && request.resource.data.displayName != "Emir";
      allow update: if isOwner(uid) && (
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName']) ||
         (request.resource.data.displayName != "Ulas" && request.resource.data.displayName != "Emir")
      );
      allow delete: if isOwner(uid);
    }

    // activeTimers collection
    match /activeTimers/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow create, update: if isAuthenticated() && request.auth.uid == uid && request.resource.data.userId == uid && (!request.resource.data.keys().hasAll(['baseTrackedSeconds']) || (request.resource.data.baseTrackedSeconds is number && request.resource.data.baseTrackedSeconds >= 0));
      allow delete: if isAuthenticated() && request.auth.uid == uid;
    }

    // Plugins collection
    match /plugins/{pluginId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAdmin();
      allow update: if isAuthenticated() && (
        isCreator(pluginId) || 
        isPluginOwner(pluginId) || 
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['startDate', 'endDate']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endDate']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['startDate'])
      );
      allow delete: if isAuthenticated() && (isCreator(pluginId) || isPluginOwner(pluginId) || isAdmin());

      // Members subcollection
      match /members/{memberUid} {
        // Any authenticated user should be able to read the member list to do client-side membership checks
        allow read: if isAuthenticated(); 
        // Only owner (or creator during setup) can write/add members
        allow write: if isPluginOwner(pluginId) || isCreator(pluginId) || isAdmin();
      }

      // Todos subcollection
      match /todos/{todoId} {
        // Only members can read/write todos
        allow read: if isMember(pluginId) || isAdmin();
        
        function validAggregates(res) {
           return (!res.keys().hasAll(['totalTrackedSeconds']) || (res.totalTrackedSeconds is number && res.totalTrackedSeconds >= 0)) &&
                  (!res.keys().hasAll(['timerTrackedSeconds']) || (res.timerTrackedSeconds is number && res.timerTrackedSeconds >= 0)) &&
                  (!res.keys().hasAll(['manualTrackedSeconds']) || (res.manualTrackedSeconds is number && res.manualTrackedSeconds >= 0)) &&
                  (!res.keys().hasAll(['timeEntryCount']) || (res.timeEntryCount is number && res.timeEntryCount >= 0));
        }
        
        allow create: if (isMember(pluginId) && request.resource.data.createdByUid == request.auth.uid && validAggregates(request.resource.data)) || isAdmin();
        allow update: if (isMember(pluginId) && resource.data.createdByUid == request.auth.uid && request.resource.data.createdByUid == resource.data.createdByUid && validAggregates(request.resource.data)) || isAdmin();
        allow delete: if (isMember(pluginId) && resource.data.createdByUid == request.auth.uid) || isAdmin();

        match /timeEntries/{entryId} {
           allow read: if isMember(pluginId) || isAdmin();
           // Only task owner can add time entries or admin
           allow create: if (isMember(pluginId) && request.resource.data.userId == request.auth.uid && get(/databases/$(database)/documents/plugins/$(pluginId)/todos/$(todoId)).data.createdByUid == request.auth.uid && request.resource.data.durationSeconds is number && request.resource.data.durationSeconds >= 0) || isAdmin();
           allow update: if (isMember(pluginId) && resource.data.userId == request.auth.uid && request.resource.data.durationSeconds is number && request.resource.data.durationSeconds >= 0) || isAdmin();
           allow delete: if (isMember(pluginId) && resource.data.userId == request.auth.uid) || isAdmin();
        }
      }

      // Notes subcollection
      match /notes/{uid} {
        // Only members can read notes (or maybe just the owner of the note?)
        // Requirement: "UI da sadece onları render eder" -> implies visibility control
        // Let's say members can read, but only owner of note can write
        allow read: if isMember(pluginId) || isAdmin();
        allow write: if (isMember(pluginId) && isOwner(uid)) || isAdmin();
      }

      // Messages subcollection (Chat)
      match /messages/{messageId} {
        allow read, write: if isMember(pluginId) || isCreator(pluginId) || isAdmin();
      }

      // Files subcollection
      match /files/{fileId} {
        allow read, write: if isMember(pluginId) || isCreator(pluginId) || isAdmin();
      }

      // Logs subcollection
      match /logs/{logId} {
        allow read, write: if isMember(pluginId) || isCreator(pluginId) || isAdmin();
      }
    }

    // Helper function to check if user is a member of YouTubers
    function isYoutubersMember() {
      return isAuthenticated() && exists(/databases/$(database)/documents/youtubers_members/$(request.auth.uid));
    }

    // System collection for shared features
    match /system/shared_notepad {
      allow read, write: if isAuthenticated();
    }

    // Youtubers collection
    match /youtubers/{youtuberId} {
      allow read, write: if isUlas() || isYoutubersMember();
    }

    // Youtubers Members collection
    match /youtubers_members/{memberUid} {
      allow read: if isAdmin() || isYoutubersMember() || request.auth.uid == memberUid;
      allow write: if isAdmin();
    }
    // Collection group query for members
    match /{path=**}/members/{memberUid} {
      allow read: if isAuthenticated();
    }

    // Roleplay Mods collection
    match /roleplayMods/{modId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
